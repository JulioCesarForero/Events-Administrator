APP_ENV=local
TZ=UTC

POSTGRES_DB=events_admin
POSTGRES_USER=events_user
POSTGRES_PASSWORD=events_pass
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
NGINX_PORT=80

DATABASE_URL=postgresql+psycopg://events_user:events_pass@db:5432/events_admin
API_BASE_URL=http://localhost/api

# Con Nginx en /api/: dejar /api para que Swagger "Try it out" y OpenAPI coincidan.
# Solo uvicorn en :8000 sin proxy: ROOT_PATH= (vacío).
ROOT_PATH=/api

# Backend (FastAPI)
JWT_SECRET=change-me-use-long-random-string
JWT_ISSUER=events-administrator
JWT_STAFF_AUDIENCE=staff
JWT_BUYER_AUDIENCE=buyer
JWT_ACCESS_TTL_MINUTES=60
DEBUG=true
CORS_ORIGINS=*
LOG_LEVEL=INFO

# Idempotencia (doc 8 §8). Dejar REDIS_URL vacío para usar la store in-memory del
# proceso (OK en single-instance/MVP). En multi-réplica, apuntar a un Redis
# compartido, p.ej. REDIS_URL=redis://redis:6379/0
REDIS_URL=
IDEMPOTENCY_TTL_SECONDS=3600

# Frontend build-time (Vite). Por defecto el SPA se sirve detrás de Nginx en /api/.
# Cambiar solo si el frontend se despliega contra un API en otra origen/prefijo.
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://backend:8000
VITE_API_TIMEOUT_MS=20000
VITE_EVIDENCE_STORAGE=signed
VITE_EVIDENCE_MAX_MB=5
