# =============================================================================
# Frontend environment variables (Vite). Copy to `.env.local` for local dev.
# Following 12-Factor III: configuration is read from the environment, not
# hard-coded in source.
# =============================================================================

# Base URL of the backend API. Leave relative to use the Vite dev proxy.
# Examples:
#   VITE_API_BASE_URL=/api/v1
#   VITE_API_BASE_URL=https://api.example.com/v1
VITE_API_BASE_URL=/api/v1

# Upstream target used by the Vite dev proxy (only in dev).
VITE_API_PROXY_TARGET=http://localhost

# Request timeout in milliseconds for all HTTP calls.
VITE_API_TIMEOUT_MS=20000

# Storage strategy for payment evidence uploads.
# - `signed`  -> request a signed URL from the backend and PUT directly.
# - `inline`  -> send the file as a base64 data URL (fallback for MVP).
VITE_EVIDENCE_STORAGE=signed

# Maximum evidence size allowed by the UI (MB).
VITE_EVIDENCE_MAX_MB=5

# Signed URL expiration used by UX hints/timers (seconds).
VITE_GCS_UPLOAD_URL_TTL_SECONDS=900
VITE_GCS_DOWNLOAD_URL_TTL_SECONDS=600
